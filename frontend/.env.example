# Serverless (Vercel) environment variables — set these in the Vercel project dashboard

# Google SSO (client ID is public; from Google Cloud Console → Credentials → OAuth client ID (Web))
# Authorized JavaScript origin: https://<your-vercel-domain>
GOOGLE_CLIENT_ID=

# GitHub SSO (from GitHub → Settings → Developer settings → OAuth Apps)
# Authorization callback URL: https://<your-vercel-domain>/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign session tokens (generate with: openssl rand -hex 32)
AUTH_SECRET=

# Optional: real LLM for chat (falls back to a free no-key provider if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
