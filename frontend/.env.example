# === FRONTEND (Vite) — PUBLIC client IDs, inlined at build time ===
# These are prefixed with VITE_ so Vite bundles them into the JS bundle.
# Google & GitHub client IDs are PUBLIC by design (they're used in browser JS).
# Get them from Google Cloud Console / GitHub OAuth Apps.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# === SERVERLESS FUNCTIONS (Vercel runtime) — SECRETS only ===
# These run in Vercel serverless functions, NOT bundled by Vite.
# In Vercel services mode, set these under Project → Environment Variables.
GITHUB_CLIENT_SECRET=
AUTH_SECRET=              # generate with: openssl rand -hex 32

# Optional: real LLM for chat (falls back to a free no-key provider if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
